# ============================================================
# 工艺文件管理系统 环境变量示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，切勿提交。
# 生产环境务必设置 SECRET_KEY 与 DATABASE_URL，并关闭演示账号。
# ============================================================

# ---------- 运行环境 ----------
# dev / prod；prod 下若仍使用默认 SECRET_KEY 将拒绝启动
ENV=dev
DEBUG=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
# 开发调试开启热重载（生产保持 false）
RELOAD=false

# ---------- 数据库 ----------
# 开发默认 SQLite（零配置）：
DATABASE_URL=sqlite+aiosqlite:///./data/processms.db
# 生产 MySQL 示例（请修改账号口令后使用）：
# DATABASE_URL=mysql+aiomysql://processms:CHANGE_ME@127.0.0.1:3306/process_file_system?charset=utf8mb4
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ---------- 安全 / JWT ----------
# 生产必须改为至少 32 位随机字符串，例如 python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 是否开放自助注册（生产建议 false）
ALLOW_REGISTER=true

# ---------- 文件上传 ----------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.txt
UPLOAD_COOLDOWN_SECONDS=2
DEFAULT_PROCESS_CODE=GEN

# ---------- 文件清单 / 调度 ----------
ENABLE_SCHEDULER=true
CATALOG_TZ=Asia/Shanghai
# 每日自动刷新小时（0 点）
CATALOG_REFRESH_HOUR=0
# 启动时是否立即生成一次清单快照
CATALOG_REFRESH_ON_STARTUP=false

# ---------- CORS / 前端 ----------
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:3000,http://127.0.0.1:3000
WEB_DIR=web

# ---------- 种子数据（仅开发/演示） ----------
# ENV=dev 时默认启用演示账号；生产必须 false
SEED_DEMO_USERS=true
# 演示账号统一初始密码：仅开发/演示环境使用，请自行填写，生产环境勿设置默认口令
SEED_PASSWORD=